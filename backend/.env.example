# Port for the Express server
PORT=5000

# Secret key for signing JWT tokens (use a random 64-char string in production)
JWT_SECRET=super_secret_cbse_jwt_key_replace_in_production_2026

# Allowed Frontend Origins (Comma-separated for multiple origins, or * for all)
CLIENT_ORIGIN=http://localhost:3000

# Environment: 'development' | 'production'
NODE_ENV=development
